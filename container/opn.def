Bootstrap: docker
From: python:3.11-slim-bookworm

# Apptainer image for the OPN / LAN+CPN modelling scripts in this repository
#   scripts/simulation/*.py, scripts/hierarchical/*.py
#
# All commands below are run from the repository root.
#
# Build (CPU):
#   apptainer build opn.sif container/opn.def
#
# Tests (unit tests of the opn library, then every script end to end with tiny settings):
#   apptainer exec --bind "$PWD" opn.sif make test
#   apptainer exec --bind "$PWD" opn.sif make smoke
#
# Run a script (inputs and default output folders are resolved from the repo,
# so the working directory does not matter):
#   apptainer run --bind "$PWD" opn.sif scripts/simulation/recover_ddm.py 0
#   apptainer run --bind "$PWD" opn.sif scripts/hierarchical/fit_hierarchical_angle.py
#
# Interactive shell:
#   apptainer shell --bind "$PWD" opn.sif
#
# Jupyter (e.g. demo/fit_demo.ipynb): start JupyterLab and open the printed URL
# (on a cluster, forward the port with ssh -L 8888:localhost:8888 <node> first):
#   apptainer exec --bind "$PWD" opn.sif jupyter lab --no-browser --port 8888
# or execute a notebook without a browser, saving its outputs in place:
#   apptainer exec --bind "$PWD" opn.sif make notebook
#
# Version pins: the code uses `from jax.config import config`
# (removed in jax 0.4.25) and `pm.ConstantData` (removed in recent PyMC), so the
# stack is pinned to an early-2024 JAX / PyMC combination. Python 3.11 is the
# only version allowed by both lanfactory (>3.10) and ssm-simulators (<3.12).

%labels
    Description OPN / LAN+CPN hierarchical modelling environment (PyMC + JAX + lanfactory)
    Python 3.11

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    # Matplotlib needs a writable config dir and no display on compute nodes
    export MPLBACKEND=Agg
    export MPLCONFIGDIR=${TMPDIR:-/tmp}/mpl-$USER
    # PyTensor compiles C code at runtime; keep its cache out of the (read-only) image
    export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor-$USER"
    export XLA_PYTHON_CLIENT_PREALLOCATE=false

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # g++ is required by PyTensor's C backend
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libgomp1 \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip setuptools wheel

    # CPU-only PyTorch (lanfactory imports torch); avoids pulling ~2 GB of CUDA libs
    pip install --no-cache-dir torch==2.2.2 --index-url https://download.pytorch.org/whl/cpu

    pip install --no-cache-dir \
        numpy==1.26.4 \
        scipy==1.12.0 \
        pandas==2.1.4 \
        matplotlib==3.8.2 \
        seaborn==0.13.2 \
        scikit-learn==1.4.2 \
        tqdm \
        jax==0.4.23 \
        jaxlib==0.4.23 \
        ml-dtypes==0.3.2 \
        numpyro==0.13.2 \
        pytensor==2.18.6 \
        pymc==5.10.4 \
        arviz==0.17.1 \
        xarray==2024.2.0 \
        h5netcdf==1.3.0 \
        netCDF4==1.6.5 \
        flax==0.7.5 \
        optax==0.1.9 \
        chex==0.1.85 \
        orbax-checkpoint==0.5.3 \
        frozendict==2.4.0 \
        onnx==1.15.0 \
        onnxruntime==1.17.1 \
        ssm-simulators==0.7.2 \
        lanfactory==0.4.6 \
        pytest==8.1.1

    # Jupyter, installed after the scientific stack so it cannot change those pins. The kernel
    # messaging packages are pinned too: other combinations failed to connect to the kernel.
    pip install --no-cache-dir \
        jupyterlab==4.1.2 \
        ipykernel==6.29.3 \
        nbconvert==7.16.1 \
        ipython==9.17.1 \
        jupyter_client==8.10.0 \
        jupyter_core==5.9.1 \
        jupyter_server==2.21.1 \
        nbclient==0.11.0 \
        nbformat==5.11.1 \
        pyzmq==27.2.0 \
        tornado==6.5.10 \
        traitlets==5.16.1 \
        matplotlib-inline==0.2.2 \
        debugpy==1.8.22

    # Fail the build early if anything the scripts import is broken
    python -c '
import ssms, lanfactory, torch, pymc, pytensor, arviz, jax, numpyro, flax, onnx, onnxruntime
import jupyterlab, ipykernel, nbconvert, nbclient
from pymc.sampling import jax as pmj
from jax.config import config
from pytensor.link.jax.dispatch import jax_funcify
assert hasattr(pmj, "sample_numpyro_nuts")
assert hasattr(lanfactory.trainers, "MLPJaxFactory")
assert "angle" in ssms.config.model_config
print([(m.__name__, getattr(m, "__version__", "?")) for m in (ssms, lanfactory, torch, pymc, pytensor, arviz, jax, numpyro, flax)])
'

%runscript
    # `apptainer run opn.sif script.py [args]` -> python script.py [args]
    if [ $# -eq 0 ]; then
        exec python
    fi
    exec python "$@"

%test
    python -c "import ssms, lanfactory, pymc, jax, numpyro; from jax.config import config; print('ok', jax.__version__, pymc.__version__)"

%help
    Environment for the OPN / LAN+CPN modelling scripts.

    From the repository root:
    Build:  apptainer build opn.sif container/opn.def
    Test:   apptainer exec --bind "$PWD" opn.sif make test     (library unit tests)
            apptainer exec --bind "$PWD" opn.sif make smoke    (all scripts, tiny settings)
    Run:    apptainer run --bind "$PWD" opn.sif scripts/simulation/recover_ddm.py 0
    Shell:  apptainer shell --bind "$PWD" opn.sif
    Jupyter: apptainer exec --bind "$PWD" opn.sif jupyter lab --no-browser --port 8888
            apptainer exec --bind "$PWD" opn.sif make notebook    (run demo/fit_demo.ipynb, no browser)

    Key versions: Python 3.11, jax 0.4.23, numpyro 0.13.2, pymc 5.10.4,
    pytensor 2.18.6, lanfactory 0.4.6, ssm-simulators 0.7.2, torch 2.2.2 (CPU),
    jupyterlab 4.1.2, ipykernel 6.29.3.
